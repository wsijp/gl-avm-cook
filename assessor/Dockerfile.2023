# The Cook County Assessor's 2023 residential model environment, rebuilt from the tag 2023-assessment-year of
# https://github.com/ccao-data/model-res-avm (commit 32542556332433790ad5e84aed1a49dbaeb8fdc3). The tag has no
# Dockerfile; this follows the tag's own CI recipe (.gitlab-ci.yml: image rocker/r-ver:4.2.2, its system packages,
# RENV_CONFIG_REPOS_OVERRIDE, renv::restore()). context/ is the tag's checkout without .git: their code, params.yaml
# and renv.lock unchanged. Departures from the CI recipe, all operational:
#  - the base image is pinned by digest (the digest current on 2026-10-18; Ubuntu 22.04 jammy);
#  - R packages come as precompiled binaries from Posit Package Manager's jammy snapshot of 2023-03-01 instead of
#    source from cloud.r-project.org; renv still installs the lockfile's exact versions (arrow 10.0.0 and lava 1.7.2
#    from the snapshot's archive). The Assessor's own three packages come from their pinned GitLab commits;
#  - no dvc install and no `dvc pull`: the inputs are mounted at run time (rebuild.sh);
#  - the renv library lives inside the image; MAKEFLAGS=-j8 only speeds up compilation.
# Built and run by rebuild.sh in this folder.
FROM rocker/r-ver:4.2.2@sha256:e868e617f2adb9740983d5fed65032afa9632308ab94bde02da09182e46f9389

ENV RENV_CONFIG_REPOS_OVERRIDE="https://p3m.dev/cran/__linux__/jammy/2023-03-01" \
    RENV_PATHS_CACHE=/opt/renv/cache \
    RENV_PATHS_LIBRARY=/model-res-avm/renv/library \
    MAKEFLAGS=-j8

RUN apt-get update && apt-get install --no-install-recommends -y \
      libcurl4-openssl-dev libssl-dev libxml2-dev libgit2-dev git libudunits2-dev python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /model-res-avm
# Lockfile and renv bootstrap first, so the long restore is its own cached layer.
COPY context/renv.lock context/.Rprofile context/.Renviron ./
COPY context/renv/activate.R context/renv/settings.dcf renv/
RUN Rscript -e 'renv::restore()' && Rscript -e 'renv::status()' \
    && Rscript -e 'ip <- installed.packages(); write.csv(ip[, c("Package","Version","Built","LibPath")], "/opt/renv_installed.csv", row.names = FALSE)'
COPY context/ ./
